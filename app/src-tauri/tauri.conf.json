{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Memoir",
  "version": "0.1.0",
  "identifier": "com.memoir.notebook",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Memoir",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: attachment: http://attachment.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Dominik Majchrzak",
    "copyright": "© 2026 Dominik Majchrzak",
    "category": "Productivity",
    "shortDescription": "Encrypted notebook that syncs through your own Google Drive",
    "longDescription": "Memoir is a personal notebook. Notes are encrypted on your device and kept in your own Google Drive.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
